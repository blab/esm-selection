from snakemake.utils import Paramspace
from pathlib import Path
import pandas as pd

# -------------------------------------------------------------------
# Segments & parameters
# -------------------------------------------------------------------
SEGMENTS = ["pb2", "pb1", "pa", "np", "na", "mp", "ns", "ha"]

# Function to get sequence count from H3N2 source files
def get_seq_count():
    from pathlib import Path
    import glob
    
    try:
        # Count sequences from all H3N2_Tree segment files
        total_count = 0
        h3n2_files = glob.glob("input/Fine_Tuning_Datasets/H3N2_Tree/fine_tune_fasta_*.fasta")
        
        for fasta_file in h3n2_files:
            with open(fasta_file, "r") as f:
                total_count += sum(1 for line in f if line.startswith('>'))
        
        return str(total_count) if total_count > 0 else "1965"
    except (FileNotFoundError, OSError):
        return "1965"  # fallback if files don't exist

# Get dynamic sequence count
SEQ_COUNT = get_seq_count()

# Dynamic dataset names based on actual sequence count
DATASETS = [
    f"H3N2_Dataset_{SEQ_COUNT}_Full",
    f"ESM_{SEQ_COUNT}_Full",
    f"pan_flu_{SEQ_COUNT}_Full",
    f"mix_AB_50_ESM_{SEQ_COUNT}_Full_50_H3N2_Dataset_{SEQ_COUNT}_Full",
    f"mix_BC_50_H3N2_Dataset_{SEQ_COUNT}_Full_50_pan_flu_{SEQ_COUNT}_Full",
    f"mix_AC_50_ESM_{SEQ_COUNT}_Full_50_pan_flu_{SEQ_COUNT}_Full",
    f"mix_ABC_33_ESM_{SEQ_COUNT}_Full_33_H3N2_Dataset_{SEQ_COUNT}_Full_33_pan_flu_{SEQ_COUNT}_Full"
]

# Params CSV (edit path as needed)
df = pd.read_csv("input/params.csv")

# Remove dataset column handling since we'll handle it via expansion
# Add default dataset if not specified
# if "dataset" not in df.columns:
#     df["dataset"] = "ESM_1965_Full"  # Default to ESM_1965_Full.fasta

# Ensure an 'lr' column exists (fallback to 'learning_rate' if provided)
if "lr" not in df.columns:
    if "learning_rate" in df.columns:
        df["lr"] = df["learning_rate"]
    else:
        raise ValueError(
            "params CSV must include an 'lr' column (or 'learning_rate')."
        )

paramspace = Paramspace(df)  # all params
PS_WC = paramspace.wildcard_pattern

BASE_MODELS = sorted(df["model"].unique())
paramspace_cmp = Paramspace(df)

# Trees list (from CSV if present; otherwise from input/trees/)
if "next_tree" in df.columns:
    TREES = sorted(df["next_tree"].dropna().unique())
else:
    TREES = sorted([d.name for d in Path("input/trees").iterdir() if d.is_dir()])

# -------------------------------------------------------------------
# Top-level targets
# -------------------------------------------------------------------
rule all:
    input:
        # Base log-likelihoods (no fine-tuning), organized same as fine-tuned results
        expand(
            "results/Log_Likelihoods/{ps}/base/Max_Freq_Fasta_LL_{segment}.csv",
            ps=paramspace_cmp.instance_patterns,
            segment=SEGMENTS,
        ),
        # Fine-tuned evaluation outputs (using dynamic dataset names)
        expand(
            "results/Log_Likelihoods/{ps}/{dataset}/Max_Freq_Fasta_LL_Fine_Tune_{segment}.csv",
            ps=paramspace_cmp.instance_patterns,
            dataset=DATASETS,
            segment=SEGMENTS,
        )

# -------------------------------------------------------------------
# Upstream preprocessing rules (unchanged)
# -------------------------------------------------------------------
rule translate_nucleotide_json:
    input:
        json_tree="input/trees/{next_tree}/{segment}.json",
        json_root="input/trees/{next_tree}/{segment}_root-sequence.json",
        script="scripts/translate_nucleotide_to_protein.py",
    output:
        "results/root_tree_translated/{next_tree}/{segment}_root-sequence.json",
    conda:
        "envs/nextstrain_env.yaml"
    container:
        "envs/nextstrain-base.sif"
    shell:
        """
        python {input.script} --tree {input.json_tree} --root {input.json_root} --segment {wildcards.segment} --output {output}
        """

rule extract_node_fastas:
    input:
        json_tree="input/trees/{next_tree}/{segment}.json",
        json_root="results/root_tree_translated/{next_tree}/{segment}_root-sequence.json",
        script="scripts/extract_fasta_nodes.py",
    output:
        "results/node_fastas/{next_tree}/nodeSeqs_{segment}.fasta",
    conda:
        "envs/nextstrain_env.yaml"
    container:
        "envs/nextstrain-base.sif"
    shell:
        """
        python {input.script} --gene {wildcards.segment} --local-files True --tree {input.json_tree} --root {input.json_root} --output {output}
        """

rule extract_max_freq:
    input:
        json_tree="input/trees/{next_tree}/{segment}.json",
        node_fastas="results/node_fastas/{next_tree}/nodeSeqs_{segment}.fasta",
        json_tip_freq="input/trees/{next_tree}/{segment}_tip-frequencies.json",
        script="scripts/extract_max_freq.py",
    output:
        "results/max_freqs/{next_tree}/Max_Freq_Fasta_{segment}.csv",
    conda:
        "envs/nextstrain_env.yaml"
    container:
        "envs/nextstrain-base.sif"
    shell:
        """
        time python {input.script} --segment {wildcards.segment} --tree {input.json_tree} --tip-freq {input.json_tip_freq} --node-fasta {input.node_fastas} --output {output}
        """

rule calc_ll_esm:
    input:
        max_freq="results/max_freqs/{next_tree}/Max_Freq_Fasta_{segment}.csv",
        script="scripts/calc_ll_esm.py",
    output:
        f"results/Log_Likelihoods/{PS_WC}/base/Max_Freq_Fasta_LL_{{segment}}.csv"
    shell:
        """
        python {input.script} --max_freq {input.max_freq} --segment {wildcards.segment} --model {wildcards.model} --output {output}
        """

# -------------------------------------------------------------------
# Generate fine-tuning FASTA files
# -------------------------------------------------------------------
rule generate_h3n2_dataset_full:
    input:
        expand("input/Fine_Tuning_Datasets/H3N2_Tree/fine_tune_fasta_{segment}.fasta", segment=SEGMENTS)
    output:
        "input/Fine_Tuning_Datasets/H3N2_Dataset_{seq_count}_Full.fasta"
    shell:
        """
        cat {input} > temp_h3n2.fasta
        SEQ_COUNT=$(grep -c '^>' temp_h3n2.fasta)
        mv temp_h3n2.fasta input/Fine_Tuning_Datasets/H3N2_Dataset_${{SEQ_COUNT}}_Full.fasta
        """

rule generate_esm_dataset:
    input:
        h3n2_fasta="input/Fine_Tuning_Datasets/H3N2_Dataset_{seq_count}_Full.fasta",
        uniref_fasta="input/Fine_Tuning_Datasets/ESM_Training_Dataset/uniref90membersandreps_ur50trainfiltreps.fasta"
    output:
        "input/Fine_Tuning_Datasets/ESM_{seq_count}_Full.fasta"
    shell:
        """
        SEQ_COUNT=$(grep -c '^>' {input.h3n2_fasta})
        # Filter sequences to max 1000 AA, then sample the required count
        seqkit seq -M 1000 {input.uniref_fasta} | seqkit sample -n $SEQ_COUNT -s 42 > input/Fine_Tuning_Datasets/ESM_${{SEQ_COUNT}}_Full.fasta
        """

rule generate_pan_flu_dataset:
    input:
        h3n2_fasta="input/Fine_Tuning_Datasets/H3N2_Dataset_{seq_count}_Full.fasta",
        pan_flu_fasta="input/Fine_Tuning_Datasets/Pan_Flu_Dataset/non_h3n2_prot.fasta"
    output:
        "input/Fine_Tuning_Datasets/pan_flu_{seq_count}_Full.fasta"
    shell:
        """
        SEQ_COUNT=$(grep -c '^>' {input.h3n2_fasta})
        seqkit sample -n $SEQ_COUNT -s 42 {input.pan_flu_fasta} > input/Fine_Tuning_Datasets/pan_flu_${{SEQ_COUNT}}_Full.fasta
        """

rule generate_mixed_datasets:
    input:
        h3n2_fasta="input/Fine_Tuning_Datasets/H3N2_Dataset_{seq_count}_Full.fasta",
        esm_fasta="input/Fine_Tuning_Datasets/ESM_{seq_count}_Full.fasta",
        pan_flu_fasta="input/Fine_Tuning_Datasets/pan_flu_{seq_count}_Full.fasta",
        script="input/Fine_Tuning_Datasets/mix_split_fastas.sh"
    output:
        "input/Fine_Tuning_Datasets/mix_AB_50_ESM_{seq_count}_Full_50_H3N2_Dataset_{seq_count}_Full.fasta",
        "input/Fine_Tuning_Datasets/mix_BC_50_H3N2_Dataset_{seq_count}_Full_50_pan_flu_{seq_count}_Full.fasta",
        "input/Fine_Tuning_Datasets/mix_AC_50_ESM_{seq_count}_Full_50_pan_flu_{seq_count}_Full.fasta",
        "input/Fine_Tuning_Datasets/mix_ABC_33_ESM_{seq_count}_Full_33_H3N2_Dataset_{seq_count}_Full_33_pan_flu_{seq_count}_Full.fasta"
    shell:
        """
        cd input/Fine_Tuning_Datasets
        SEQ_COUNT=$(grep -c '^>' H3N2_Dataset_{wildcards.seq_count}_Full.fasta)
        ./mix_split_fastas.sh $SEQ_COUNT
        """

# -------------------------------------------------------------------
# Fine-tune model (learning rate comes from params.csv: 'lr' column)
# -------------------------------------------------------------------
rule generate_fine_tune_model:
    input:
        fasta   = "input/Fine_Tuning_Datasets/{dataset}.fasta",
        script  = "scripts/make_esm_fine_tune_models.py",
    output:
        model_bin = f"results/fine_tune_models/{PS_WC}/{{dataset}}/Fine_Tune_Model.bin",
    params:
        chosen_lr = lambda wildcards: str(wildcards.lr)
    shell:
        r'''
        set -euo pipefail

        mkdir -p "$(dirname "{output.model_bin}")"

        python "{input.script}" \
          --model "{wildcards.model}" \
          --input "{input.fasta}" \
          --output "{output.model_bin}" \
          --epochs "{wildcards.epochs}" \
          --learning-rate "{params.chosen_lr}"
        '''

# -------------------------------------------------------------------
# Evaluate fine-tuned model (unchanged)
# -------------------------------------------------------------------
rule calc_ll_esm_Fine_tune:
    input:
        max_freq="results/max_freqs/{next_tree}/Max_Freq_Fasta_{segment}.csv",
        script="scripts/calc_ll_esm.py",
        fine_tune_model=f"results/fine_tune_models/{PS_WC}/{{dataset}}/Fine_Tune_Model.bin",
    output:
        f"results/Log_Likelihoods/{PS_WC}/{{dataset}}/Max_Freq_Fasta_LL_Fine_Tune_{{segment}}.csv",
    shell:
        """
        python {input.script} --max_freq {input.max_freq} --segment {wildcards.segment} --model {wildcards.model} --fine_tune_model {input.fine_tune_model} --epochs {wildcards.epochs} --output {output}
        """
