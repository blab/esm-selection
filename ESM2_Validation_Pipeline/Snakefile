from snakemake.utils import Paramspace
from pathlib import Path
import pandas as pd

# -------------------------------------------------------------------
# Segments & parameters
# -------------------------------------------------------------------
SEGMENTS = ["pb2", "pb1", "pa", "np", "na", "mp", "ns", "ha"]

# Available datasets for fine-tuning
DATASETS = [
    "ESM_1965_Full",
    "H3N2_Dataset_Full", 
    "pan_flu_1965_Full",
    "mix_AB_50_ESM_1965_Full_50_H3N2_Dataset_Full",
    "mix_BC_50_H3N2_Dataset_Full_50_pan_flu_1965_Full",
    "mix_AC_50_ESM_1965_Full_50_pan_flu_1965_Full",
    "mix_ABC_33_ESM_1965_Full_33_H3N2_Dataset_Full_33_pan_flu_1965_Full"
]

# Params CSV (edit path as needed)
df = pd.read_csv("input/params.csv")

# Remove dataset column handling since we'll handle it via expansion
# Add default dataset if not specified
# if "dataset" not in df.columns:
#     df["dataset"] = "ESM_1965_Full"  # Default to ESM_1965_Full.fasta

# Ensure an 'lr' column exists (fallback to 'learning_rate' if provided)
if "lr" not in df.columns:
    if "learning_rate" in df.columns:
        df["lr"] = df["learning_rate"]
    else:
        raise ValueError(
            "params CSV must include an 'lr' column (or 'learning_rate')."
        )

paramspace = Paramspace(df)  # all params
PS_WC = paramspace.wildcard_pattern

BASE_MODELS = sorted(df["model"].unique())
paramspace_cmp = Paramspace(df)

# Trees list (from CSV if present; otherwise from input/trees/)
if "next_tree" in df.columns:
    TREES = sorted(df["next_tree"].dropna().unique())
else:
    TREES = sorted([d.name for d in Path("input/trees").iterdir() if d.is_dir()])

# -------------------------------------------------------------------
# Top-level targets
# -------------------------------------------------------------------
rule all:
    input:
        # Base log-likelihoods (no fine-tuning), organized same as fine-tuned results
        expand(
            "results/max_freqs_log_likelyhood_Fine_Tune/{ps}/base/Max_Freq_Fasta_LL_{segment}.csv",
            ps=paramspace_cmp.instance_patterns,
            segment=SEGMENTS,
        ),
        # Fine-tuned evaluation outputs (expanded across all datasets)
        expand(
            "results/max_freqs_log_likelyhood_Fine_Tune/{ps}/{dataset}/Max_Freq_Fasta_LL_Fine_Tune_{segment}.csv",
            ps=paramspace_cmp.instance_patterns,
            dataset=DATASETS,
            segment=SEGMENTS,
        )

# -------------------------------------------------------------------
# Upstream preprocessing rules (unchanged)
# -------------------------------------------------------------------
rule translate_nucleotide_json:
    input:
        json_tree="input/trees/{next_tree}/{segment}.json",
        json_root="input/trees/{next_tree}/{segment}_root-sequence.json",
        script="scripts/translate_nucleotide_to_protein.py",
    output:
        "results/root_tree_translated/{next_tree}/{segment}_root-sequence.json",
    conda:
        "envs/nextstrain_env.yaml"
    container:
        "envs/nextstrain-base.sif"
    shell:
        """
        python {input.script} --tree {input.json_tree} --root {input.json_root} --segment {wildcards.segment} --output {output}
        """

rule extract_node_fastas:
    input:
        json_tree="input/trees/{next_tree}/{segment}.json",
        json_root="results/root_tree_translated/{next_tree}/{segment}_root-sequence.json",
        script="scripts/extract_fasta_nodes.py",
    output:
        "results/node_fastas/{next_tree}/nodeSeqs_{segment}.fasta",
    conda:
        "envs/nextstrain_env.yaml"
    container:
        "envs/nextstrain-base.sif"
    shell:
        """
        python {input.script} --gene {wildcards.segment} --local-files True --tree {input.json_tree} --root {input.json_root} --output {output}
        """

rule extract_max_freq:
    input:
        json_tree="input/trees/{next_tree}/{segment}.json",
        node_fastas="results/node_fastas/{next_tree}/nodeSeqs_{segment}.fasta",
        json_tip_freq="input/trees/{next_tree}/{segment}_tip-frequencies.json",
        script="scripts/extract_max_freq.py",
    output:
        "results/max_freqs/{next_tree}/Max_Freq_Fasta_{segment}.csv",
    conda:
        "envs/nextstrain_env.yaml"
    container:
        "envs/nextstrain-base.sif"
    shell:
        """
        time python {input.script} --segment {wildcards.segment} --tree {input.json_tree} --tip-freq {input.json_tip_freq} --node-fasta {input.node_fastas} --output {output}
        """

rule calc_ll_esm:
    input:
        max_freq="results/max_freqs/{next_tree}/Max_Freq_Fasta_{segment}.csv",
        script="scripts/calc_ll_esm.py",
    output:
        f"results/max_freqs_log_likelyhood_Fine_Tune/{PS_WC}/base/Max_Freq_Fasta_LL_{{segment}}.csv"
    shell:
        """
        python {input.script} --max_freq {input.max_freq} --segment {wildcards.segment} --model {wildcards.model} --output {output}
        """

# -------------------------------------------------------------------
# Fine-tune model (learning rate comes from params.csv: 'lr' column)
# -------------------------------------------------------------------
rule generate_fine_tune_model:
    input:
        fasta   = "input/Fine_Tuning_Datasets/{dataset}.fasta",
        script  = "scripts/make_esm_fine_tune_models.py",
    output:
        model_bin = f"results/fine_tune_models/{PS_WC}/{{dataset}}/Fine_Tune_Model_{{segment}}.bin",
    params:
        chosen_lr = lambda wildcards: str(wildcards.lr)
    shell:
        r'''
        set -euo pipefail

        mkdir -p "$(dirname "{output.model_bin}")"

        python "{input.script}" \
          --model "{wildcards.model}" \
          --input "{input.fasta}" \
          --output "{output.model_bin}" \
          --epochs "{wildcards.epochs}" \
          --learning-rate "{params.chosen_lr}" \
          --segment "{wildcards.segment}"
        '''

# -------------------------------------------------------------------
# Evaluate fine-tuned model (unchanged)
# -------------------------------------------------------------------
rule calc_ll_esm_Fine_tune:
    input:
        max_freq="results/max_freqs/{next_tree}/Max_Freq_Fasta_{segment}.csv",
        script="scripts/calc_ll_esm.py",
        fine_tune_model=f"results/fine_tune_models/{PS_WC}/{{dataset}}/Fine_Tune_Model_{{segment}}.bin",
    output:
        f"results/max_freqs_log_likelyhood_Fine_Tune/{PS_WC}/{{dataset}}/Max_Freq_Fasta_LL_Fine_Tune_{{segment}}.csv",
    shell:
        """
        python {input.script} --max_freq {input.max_freq} --segment {wildcards.segment} --model {wildcards.model} --fine_tune_model {input.fine_tune_model} --epochs {wildcards.epochs} --output {output}
        """
