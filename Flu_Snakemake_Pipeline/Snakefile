# Snakefile — with LR finder integration (fixed segment handling + metrics snapshots)

from snakemake.utils import Paramspace
from pathlib import Path
import pandas as pd
import json

# -------------------------------------------------------------------
# Segments & parameters
# -------------------------------------------------------------------
SEGMENTS = ["pb2", "pb1", "pa", "np", "na", "mp", "ns", "ha"]

# Params CSV (edit path as needed)
df = pd.read_csv("input/params_lora_2.csv")

# Ensure a 'lora' column exists; default to 'lora' (meaning: enable LoRA)
if "lora" not in df.columns:
    df["lora"] = "lora"

paramspace = Paramspace(df)  # all params
PS_WC = paramspace.wildcard_pattern

BASE_MODELS = sorted(df["model"].unique())

# If you want to restrict to 650M/15B only, filter df before building paramspace_cmp.
# For now, run LR finder + FT for all rows in the CSV:
paramspace_cmp = Paramspace(df)

# Trees list (from CSV if present; otherwise from input/trees/)
if "next_tree" in df.columns:
    TREES = sorted(df["next_tree"].dropna().unique())
else:
    TREES = sorted([d.name for d in Path("input/trees").iterdir() if d.is_dir()])

# -------------------------------------------------------------------
# Top-level targets
# -------------------------------------------------------------------
rule all:
    input:
        # Base log-likelihoods (no fine-tuning), for all models present
        expand(
            "results/max_freqs_log_likelyhood/{next_tree}/Max_Freq_Fasta_LL_{model}_{segment}.csv",
            next_tree=TREES,
            model=BASE_MODELS,
            segment=SEGMENTS,
        ),
        # LR-finder artifacts for each paramspace instance & segment
        expand(
            "results/lr_finder/{ps}/lr_{segment}.json",
            ps=paramspace_cmp.instance_patterns,
            segment=SEGMENTS,
        ),
        expand(
            "results/lr_finder/{ps}/plots/{segment}_lr_finder.png",
            ps=paramspace_cmp.instance_patterns,
            segment=SEGMENTS,
        ),
        # Fine-tuned outputs (using LR chosen by LR finder)
        expand(
            "results/max_freqs_log_likelyhood_Fine_Tune/{ps}/Max_Freq_Fasta_LL_Fine_Tune_{segment}.csv",
            ps=paramspace_cmp.instance_patterns,
            segment=SEGMENTS,
        )

# -------------------------------------------------------------------
# Upstream preprocessing rules (unchanged)
# -------------------------------------------------------------------
rule translate_nucleotide_json:
    input:
        json_tree="input/trees/{next_tree}/{segment}.json",
        json_root="input/trees/{next_tree}/{segment}_root-sequence.json",
        script="scripts/translate_nucleotide_to_protein.py",
    output:
        "results/root_tree_translated/{next_tree}/{segment}_root-sequence.json",
    conda:
        "envs/nextstrain_env.yaml"
    container:
        "envs/nextstrain-base.sif"
    shell:
        """
        python {input.script} --tree {input.json_tree} --root {input.json_root} --segment {wildcards.segment} --output {output}
        """

rule extract_node_fastas:
    input:
        json_tree="input/trees/{next_tree}/{segment}.json",
        json_root="results/root_tree_translated/{next_tree}/{segment}_root-sequence.json",
        script="scripts/extract_fasta_nodes.py",
    output:
        "results/node_fastas/{next_tree}/nodeSeqs_{segment}.fasta",
    conda:
        "envs/nextstrain_env.yaml"
    container:
        "envs/nextstrain-base.sif"
    shell:
        """
        python {input.script} --gene {wildcards.segment} --local-files True --tree {input.json_tree} --root {input.json_root} --output {output}
        """

rule extract_max_freq:
    input:
        json_tree="input/trees/{next_tree}/{segment}.json",
        node_fastas="results/node_fastas/{next_tree}/nodeSeqs_{segment}.fasta",
        json_tip_freq="input/trees/{next_tree}/{segment}_tip-frequencies.json",
        script="scripts/extract_max_freq.py",
    output:
        "results/max_freqs/{next_tree}/Max_Freq_Fasta_{segment}.csv",
    conda:
        "envs/nextstrain_env.yaml"
    container:
        "envs/nextstrain-base.sif"
    shell:
        """
        time python {input.script} --segment {wildcards.segment} --tree {input.json_tree} --tip-freq {input.json_tip_freq} --node-fasta {input.node_fastas} --output {output}
        """

rule calc_ll_esm:
    input:
        max_freq="results/max_freqs/{next_tree}/Max_Freq_Fasta_{segment}.csv",
        script="scripts/calc_ll_esm.py",
    output:
        "results/max_freqs_log_likelyhood/{next_tree}/Max_Freq_Fasta_LL_{model}_{segment}.csv"
    shell:
        """
        python {input.script} --max_freq {input.max_freq} --segment {wildcards.segment} --model {wildcards.model} --output {output}
        """

# -------------------------------------------------------------------
# Fine-tune data extraction (unchanged)
# -------------------------------------------------------------------
rule extract_fine_tune_fasta:
    input:
        json_tree="input/trees/{next_tree}/{segment}.json",
        node_fastas="results/node_fastas/{next_tree}/nodeSeqs_{segment}.fasta",
        script="scripts/extract_fine_tune_fasta.py",
        max_freq="results/max_freqs/{next_tree}/Max_Freq_Fasta_{segment}.csv",
    output:
        f"results/fine_tune_fastas/{PS_WC}/fine_tune_fasta_{{segment}}.fasta",
    conda:
        "envs/nextstrain_env.yaml"
    container:
        "envs/nextstrain-base.sif"
    shell:
        """
        python {input.script} --gene {wildcards.segment} --tree {input.json_tree} --node-fasta {input.node_fastas} --max-freq {input.max_freq} --time {wildcards.time} --output {output}
        """

rule lr_finder:
    input:
        fine_tune_fasta = f"results/fine_tune_fastas/{PS_WC}/fine_tune_fasta_{{segment}}.fasta",
        script = "scripts/run_lr_finder.py",
    output:
        lr_json = f"results/lr_finder/{PS_WC}/lr_{{segment}}.json",
        lr_plot = f"results/lr_finder/{PS_WC}/plots/{{segment}}_lr_finder.png",
    params:
        lr_min = 1e-7,
        lr_max = 5e-4,
        steps  = 100,
        mode   = "exp",
        strategy = "slope",
        factor   = 3.0,
        batch_size = lambda wc: 8 if "650M" in wc.model else (2 if "3B" in wc.model else 1),
        min_steps = None,
    shell:
        r"""
        # Toggle LoRA
        case "{wildcards.lora}" in
          lora|LORA|true|True|1) LORA_FLAG="on" ;;
          *) LORA_FLAG="off" ;;
        esac

        # Optional flag for min steps per epoch
        EXTRA_MIN_STEPS=""
        if [ -n "{params.min_steps}" ] && [ "{params.min_steps}" != "None" ]; then
          EXTRA_MIN_STEPS="--min-steps-per-epoch {params.min_steps}"
        fi

        python {input.script} \
          --input {input.fine_tune_fasta} \
          --model {wildcards.model} \
          --segment {wildcards.segment} \
          --lora "$LORA_FLAG" \
          --steps {params.steps} \
          --lr-min {params.lr_min} \
          --lr-max {params.lr_max} \
          --mode {params.mode} \
          --strategy {params.strategy} \
          --factor {params.factor} \
          --batch-size {params.batch_size} \
          $EXTRA_MIN_STEPS \
          --out {output.lr_json} \
          --plot {output.lr_plot}
        """

# -------------------------------------------------------------------
# Fine-tune model (fixed: no hard-coded pb2; adds segment/logdir/run-id/snapshots)
# -------------------------------------------------------------------
rule generate_fine_tune_model:
    input:
        fasta   = f"results/fine_tune_fastas/{PS_WC}/fine_tune_fasta_{{segment}}.fasta",
        lr_json = f"results/lr_finder/{PS_WC}/lr_{{segment}}.json",
        script  = "scripts/make_esm_fine_tune_models.py",
    output:
        model_bin = f"results/fine_tune_models/{PS_WC}/Fine_Tune_Model_{{segment}}.bin",
    params:
        chosen_lr = lambda wildcards, input: json.load(open(input.lr_json))["chosen_learning_rate"]
    shell:
        r'''
        set -euo pipefail

        mkdir -p "$(dirname "{output.model_bin}")"
        logdir="$(dirname "{output.model_bin}")/metrics"
        run_id="{wildcards.time}"
        outdir="$(dirname "{output.model_bin}")/adapters_{wildcards.segment}"

        case "{wildcards.lora}" in
          lora|LORA|true|True|1) extra="--peft-output $outdir"; mkdir -p "$outdir" ;;
          *) extra="";;
        esac

        python "{input.script}" \
          --model "{wildcards.model}" \
          --input "{input.fasta}" \
          --output "{output.model_bin}" \
          --epochs "{wildcards.epochs}" \
          --learning-rate "{params.chosen_lr}" \
          --segment "{wildcards.segment}" \
          --logdir "$logdir" \
          --run-id "$run_id" \
          --metrics-write-every-steps 50 \
          $extra
        '''

# -------------------------------------------------------------------
# Evaluate fine-tuned model (unchanged, but now runs after LR-picked FT)
# -------------------------------------------------------------------
rule calc_ll_esm_Fine_tune:
    input:
        max_freq="results/max_freqs/{next_tree}/Max_Freq_Fasta_{segment}.csv",
        script="scripts/calc_ll_esm.py",
        fine_tune_model=f"results/fine_tune_models/{PS_WC}/Fine_Tune_Model_{{segment}}.bin",
    output:
        f"results/max_freqs_log_likelyhood_Fine_Tune/{PS_WC}/Max_Freq_Fasta_LL_Fine_Tune_{{segment}}.csv",
    shell:
        """
        python {input.script} --max_freq {input.max_freq} --segment {wildcards.segment} --model {wildcards.model} --fine_tune_model {input.fine_tune_model} --epochs {wildcards.epochs} --output {output}
        """
